<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="app-bg" stylesheets="@../style/pages.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.first_sem_final_project.controller.StockController">
    <padding><Insets bottom="22" left="22" right="22" top="14" /></padding>

    <VBox spacing="-14">
        <!-- gold name badge sitting on the frame -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 4;">
            <HBox alignment="CENTER" spacing="10" styleClass="store-badge">
                <Label styleClass="badge-crown" text="👑" />
                <Label styleClass="badge-text" text="Nexus Wine Store" />
            </HBox>
        </HBox>

        <HBox styleClass="shell" VBox.vgrow="ALWAYS">

            <!-- ================= SIDEBAR (shared) ================= -->
            <fx:include fx:id="sidebar" source="SideBar.fxml" />

            <!-- ================= PAGE CONTENT ================= -->
            <VBox spacing="16" styleClass="pg-page" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="20" left="26" right="26" top="24" /></padding>

                <!-- header -->
                <HBox alignment="TOP_LEFT">
                    <VBox spacing="3">
                        <Label styleClass="pg-title" text="Stock" />
                        <Label styleClass="pg-sub" text="Track and update your stock levels" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label styleClass="pg-muted" text="📅" />
                        <Label fx:id="lblDate" styleClass="pg-clock" text="--" />
                        <Label styleClass="pg-muted" text="🕙" />
                        <Label fx:id="lblTime" styleClass="pg-clock" text="--" />
                    </HBox>
                </HBox>

                <!-- search + buttons -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="pg-search" HBox.hgrow="ALWAYS">
                        <Label styleClass="pg-search-icon" text="🔍" />
                        <TextField fx:id="txtSearch" promptText="Search stock..." styleClass="pg-search-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <Button onAction="#handleAdd" styleClass="pg-btn-gold" text="＋ Add Stock" />
                    <Button onAction="#handleExport" styleClass="pg-btn-outline" text="⭳ Export" />
                </HBox>

                <!-- table card -->
                <VBox spacing="10" styleClass="pg-card" VBox.vgrow="ALWAYS">
                    <TableView fx:id="table" styleClass="pg-table" VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblCount" styleClass="pg-muted" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="pagination" alignment="CENTER_RIGHT" spacing="8" />
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</StackPane>
