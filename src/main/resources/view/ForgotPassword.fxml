<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="560" prefWidth="520" styleClass="login-root" stylesheets="@../style/Login.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.first_sem_final_project.controller.ForgotPasswordController">

    <VBox alignment="TOP_CENTER" maxWidth="430" spacing="0">
        <padding><Insets bottom="30" left="30" right="30" top="48" /></padding>

        <Label styleClass="crown" text="👑" />
        <Label styleClass="brand" text="NEXUS WINE STORE" />

        <Label fx:id="lblTitle" styleClass="login-title" text="RESET YOUR PASSWORD">
            <VBox.margin><Insets bottom="8" top="28" /></VBox.margin>
        </Label>
        <Label fx:id="lblHint" maxWidth="400" styleClass="small-text" text="Enter your username and the phone number saved on your account." textAlignment="CENTER" wrapText="true">
            <VBox.margin><Insets bottom="20" /></VBox.margin>
        </Label>

        <!-- ============ STEP 1 : verify ============ -->
        <VBox fx:id="step1" spacing="16">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="input-box">
                <Label styleClass="input-icon" text="👤" />
                <TextField fx:id="txtUsername" onAction="#onVerify" promptText="Enter Username" styleClass="input-field" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="input-box">
                <Label styleClass="input-icon" text="📞" />
                <TextField fx:id="txtPhone" onAction="#onVerify" promptText="Enter Phone Number" styleClass="input-field" HBox.hgrow="ALWAYS" />
            </HBox>
            <Button fx:id="btnVerify" maxWidth="Infinity" onAction="#onVerify" styleClass="login-btn" text="VERIFY">
                <VBox.margin><Insets top="6" /></VBox.margin>
            </Button>
        </VBox>

        <!-- ============ STEP 2 : new password ============ -->
        <VBox fx:id="step2" managed="false" spacing="16" visible="false">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="input-box">
                <Label styleClass="input-icon" text="🔒" />
                <PasswordField fx:id="txtNewPassword" onAction="#onReset" promptText="New Password" styleClass="input-field" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="input-box">
                <Label styleClass="input-icon" text="🔒" />
                <PasswordField fx:id="txtConfirmPassword" onAction="#onReset" promptText="Confirm New Password" styleClass="input-field" HBox.hgrow="ALWAYS" />
            </HBox>
            <Button fx:id="btnReset" maxWidth="Infinity" onAction="#onReset" styleClass="login-btn" text="RESET PASSWORD">
                <VBox.margin><Insets top="6" /></VBox.margin>
            </Button>
        </VBox>

        <Label fx:id="lblMessage" managed="false" maxWidth="430" styleClass="error-label" visible="false" wrapText="true">
            <VBox.margin><Insets top="12" /></VBox.margin>
        </Label>

        <HBox alignment="CENTER">
            <VBox.margin><Insets top="18" /></VBox.margin>
            <Hyperlink onAction="#onBackToLogin" styleClass="contact-link" text="← Back to Login" />
        </HBox>

        <Region VBox.vgrow="ALWAYS" />
    </VBox>

    <Region mouseTransparent="true" styleClass="frame" />
</StackPane>
