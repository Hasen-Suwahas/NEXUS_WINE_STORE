<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" stylesheets="@../style/report.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.first_sem_final_project.controller.ReportController">
    <padding><Insets bottom="20" left="24" right="24" top="22" /></padding>

    <!-- header -->
    <VBox spacing="2">
        <Label styleClass="rp-title" text="Reports" />
        <Label styleClass="rp-muted" text="Pick a report and a period, then export it if you need a copy." />
    </VBox>

    <!-- filters -->
    <VBox styleClass="rp-panel">
        <HBox alignment="BOTTOM_LEFT" spacing="16">
            <VBox spacing="6">
                <Label styleClass="rp-caption" text="Report" />
                <ComboBox fx:id="cmbReport" prefWidth="230" styleClass="rp-combo" />
            </VBox>

            <HBox fx:id="boxDates" alignment="BOTTOM_LEFT" spacing="16">
                <VBox spacing="6">
                    <Label styleClass="rp-caption" text="From" />
                    <DatePicker fx:id="dpFrom" editable="false" prefWidth="150" styleClass="rp-date" />
                </VBox>
                <VBox spacing="6">
                    <Label styleClass="rp-caption" text="To" />
                    <DatePicker fx:id="dpTo" editable="false" prefWidth="150" styleClass="rp-date" />
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="2">
                    <Button focusTraversable="false" onAction="#quickRange" styleClass="rp-chip" text="Today" userData="0" />
                    <Button focusTraversable="false" onAction="#quickRange" styleClass="rp-chip" text="7 days" userData="7" />
                    <Button focusTraversable="false" onAction="#quickRange" styleClass="rp-chip" text="30 days" userData="30" />
                    <Button focusTraversable="false" onAction="#quickRange" styleClass="rp-chip" text="This month" userData="M" />
                </HBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnExport" focusTraversable="false" onAction="#exportCsv" styleClass="rp-btn-ghost" text="Export CSV" />
            <Button fx:id="btnGenerate" focusTraversable="false" onAction="#generate" styleClass="rp-btn" text="Generate" />
        </HBox>
    </VBox>

    <!-- summary figures -->
    <HBox spacing="14">
        <VBox maxWidth="Infinity" prefWidth="1" spacing="4" styleClass="rp-stat" HBox.hgrow="ALWAYS">
            <Label fx:id="lblCap1" styleClass="rp-stat-cap" text="—" />
            <Label fx:id="lblVal1" styleClass="rp-stat-val" text="0" />
        </VBox>
        <VBox maxWidth="Infinity" prefWidth="1" spacing="4" styleClass="rp-stat" HBox.hgrow="ALWAYS">
            <Label fx:id="lblCap2" styleClass="rp-stat-cap" text="—" />
            <Label fx:id="lblVal2" styleClass="rp-stat-val" text="0" />
        </VBox>
        <VBox maxWidth="Infinity" prefWidth="1" spacing="4" styleClass="rp-stat" HBox.hgrow="ALWAYS">
            <Label fx:id="lblCap3" styleClass="rp-stat-cap" text="—" />
            <Label fx:id="lblVal3" styleClass="rp-stat-val" text="0" />
        </VBox>
    </HBox>

    <!-- the report itself -->
    <VBox spacing="10" styleClass="rp-panel" VBox.vgrow="ALWAYS">
        <HBox alignment="BASELINE_LEFT" spacing="12">
            <Label fx:id="lblTitle" styleClass="rp-panel-title" text="Report" />
            <Label fx:id="lblSub" styleClass="rp-muted" text="" />
        </HBox>
        <TableView fx:id="tblReport" styleClass="rp-table" VBox.vgrow="ALWAYS" />
        <Label fx:id="lblStatus" styleClass="rp-muted" text="" />
    </VBox>
</VBox>
